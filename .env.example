DATABASE_URL=sqlite:///./restaurant.db
# Business time zone for shifts, audits, orders and delivery days
TIMEZONE=Europe/Berlin
# Orders must be in before this local time on the day before a delivery
ORDER_CUTOFF=14:00
# Apply pending Alembic migrations when the app starts
MIGRATE_ON_STARTUP=true
# Receive due purchase orders automatically every day at this Berlin time
AUTO_RECEIVE_ENABLED=true
AUTO_RECEIVE_TIME=06:00
# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
